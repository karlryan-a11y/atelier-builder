# Renderer box config (set these as Fly/Railway secrets — never commit real values).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The invisible render page bundled by atelier-builder. Defaults to the prod builder origin.
ATELIER_RENDER_URL=https://atelier-builder.vercel.app/render.html

# Optional: lets a trusted server (e.g. the intake-replace edge function) call /regenerate
# with the `x-renderer-secret` header instead of a user JWT. Leave blank to require a JWT.
RENDERER_SHARED_SECRET=

PORT=8080
