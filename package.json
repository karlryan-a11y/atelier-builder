{
  "name": "atelier-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/run-checks.mjs build && tsc -b && vite build && node scripts/publish-code-snapshot.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "guard": "node scripts/run-checks.mjs guard",
    "deploy": "npm run guard && vercel deploy --prod --yes",
    "ship": "npm run guard && git push && vercel deploy --prod --yes",
    "check:closet-chips": "node scripts/check-closet-chips.mjs",
    "check:look-numbering": "node scripts/check-look-numbering.mjs",
    "check:card-select": "node scripts/check-card-select.mjs",
    "check:hidden-piece": "node scripts/check-hidden-piece.mjs",
    "check:rebuild-replaces": "node scripts/check-rebuild-replaces.mjs",
    "check:capsule-add-looks": "node scripts/check-capsule-add-looks.mjs",
    "check:category-reorder": "node scripts/check-category-reorder.mjs",
    "check:capsule-order": "node scripts/check-capsule-order.mjs",
    "check:add-picture": "node scripts/check-add-picture.mjs",
    "check:bake-stripes": "node scripts/check-bake-stripes.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.100.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "heic-convert": "^2.1.0",
    "heic2any": "^0.0.4",
    "konva": "^10.3.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-konva": "^19.2.4",
    "shadcn": "^4.7.0",
    "sharp": "^0.35.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "openai": "^6.37.0",
    "pg": "^8.20.0",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.2.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
